.venv/
__pycache__/
*.py[cod]
*.egg-info/
.DS_Store
.python-version

# Keep personal manuscripts and generated output in one local-only workspace.
local_data/**
!local_data/.gitkeep

# Manuscript/project data must never be committed. Test fixtures are generated
# in temporary directories; the public PAGE schema is stored as .xsd.
*.xml
*.XML
*.docx
*.DOCX
*.jpg
*.JPG
*.jpeg
*.JPEG
*.png
*.PNG
*.tif
*.TIF
*.tiff
*.TIFF
correction_history/
**/correction_history/
*.page-editor.json
manifest.json
**/manifest.json
*.html
!docs/
!docs/**
!docs/**/*.html

# Build/test artefacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
